<?xml version="1.0" encoding="utf-8"?>
<!--
    暗号化 DB も Keystore 上の鍵も端末から出さない方針のため、
    クラウドバックアップと端末間転送の両方から全ドメインを除外する。
    データを持ち出す手段はアプリ内の「暗号化バックアップ」だけに限定する。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
